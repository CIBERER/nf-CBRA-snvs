/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CIBERER/nf-CBRA-snvs tblab Parameters Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Template configuration file to override parameters for the tblab profile.
    Copy this file and fill in the paths to your annotation files.
    
    Usage:
        nextflow run main.nf -profile tblab -c /path/to/your_custom.config
----------------------------------------------------------------------------------------
*/

params {
    
    // Plugins directory for VEP
    plugins_dir = ""

    // dbscSNV - Database for splicing consensus
    dbscSNV = ""

    // dbNSFP - Database for non-synonymous functional predictions
    dbNSFP = ""
    dbNSFP_gene = ""

    // Population frequencies - gnomAD genomes
    gnomadg = ""
    gnomadg_cov = ""
    
    // Population frequencies - gnomAD exomes
    gnomade = ""
    gnomade_cov = ""

    // cSVS - Collaborative Spanish Variant Server
    cSVS = ""

    // Kaviar - Known VARiants database
    kaviar = ""

    // MAF FJD Cohort - Internal cohort frequencies
    maf_FJD_COHORT = ""

    // Pathogenicity Prediction - CADD
    CADD_SNVS = ""
    CADD_INDELS = ""

    // Pathogenicity Prediction - MutScore
    mutscore = ""

    // Pathogenicity Prediction - REVEL
    revel = ""

    // Pathogenicity Prediction - LoFtool
    loFtool = ""

    // Pathogenicity Prediction - exACpLI
    exACpLI = ""

    // Clinical databases - ClinVar
    clinvar = ""

    // Clinical databases - OMIM
    omim = ""

    // Constraint regions - cCRS_DB
    cCRS_DB = ""

    // De novo variants database
    dENOVO_DB = ""

    // Splicing prediction - SpliceAI
    spliceAI_SNV = ""
    spliceAI_INDEL = ""
    
    // Splicing prediction - MaxEntScan
    maxEntScan = ""

    // Domino - Gene-disease associations
    domino = ""

    // Tissue expression data
    tissue_expression = ""

    // Region dictionary
    region_dict = ""

    // Gene Panels for annotation
    gene_panels = ""
}
